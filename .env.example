# ---------------------------------------------------------------------------
# StoqBook environment
# ---------------------------------------------------------------------------

# Postgres (docker compose)
POSTGRES_USER=stoqbook_user
POSTGRES_PASSWORD=stoqbook_password
POSTGRES_DB=stoqbook_db
POSTGRES_PORT=5433

# Application database connection.
# Use 127.0.0.1 rather than `localhost`: on Windows `localhost` resolves to the
# IPv6 loopback (::1) while Docker publishes the port on IPv4 only, which makes
# connections hang instead of failing fast.
DATABASE_URL=postgresql://stoqbook_user:stoqbook_password@127.0.0.1:5433/stoqbook_db

# Session signing secret — replace in every real deployment
SESSION_SECRET=dev-only-secret-change-me

# Public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_PORT=3000

# ---------------------------------------------------------------------------
# Background jobs — pick ONE of the three ways to drain the queue.
# Nothing outbound is delivered until one of them is running: notifications,
# scheduled reports and the ledger integrity check all go through the queue.
# ---------------------------------------------------------------------------

# 1. Standalone worker (recommended once delivery matters): `npm run worker`.
#    Survives a web-server restart. Needs no settings here.

# 2. In-process ticker: simplest for a single box, dies with the web server.
JOB_TICKER=0
JOB_TICKER_INTERVAL_MS=60000

# 3. External cron POSTing to /api/jobs/tick with this as a bearer token.
#    The endpoint returns 503 while this is unset — an unguarded tick endpoint
#    is a denial-of-service handle. Generate one per installation:
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOB_TICK_SECRET=

# Seed credentials (used by npm run db:seed)
SEED_DEV_ADMIN_EMAIL=dev@stoqbook.app
SEED_DEV_ADMIN_PASSWORD=Stoqbook@123
SEED_TENANT_OWNER_EMAIL=owner@freshmart.test
SEED_TENANT_OWNER_PASSWORD=Stoqbook@123
